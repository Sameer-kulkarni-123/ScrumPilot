# Database Configuration
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/scrumpilot

# Groq API (Get from: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Jira Configuration (Get token from: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
#JIRA_PROJECT_KEY=SP
# Optional: Multi-project + team routing config
# If set, ScrumPilot routes issues across multiple Jira projects/components.
JIRA_ROUTING_CONFIG_PATH=backend/config/jira_routing.json
# Routing confidence thresholds (0.0–1.0).  Defaults: high=0.75, medium=0.40
# Items >= high  → auto-route.  Items in [medium,high) → route with card.
# Items < medium → LLM fallback, then triage.
ROUTING_HIGH_CONFIDENCE=0.75
ROUTING_MEDIUM_CONFIDENCE=0.40

# Telegram Bot (Get from: @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional: Google Meet Integration
GOOGLE_MEET_EMAIL=your-email@gmail.com
GOOGLE_MEET_PASSWORD=your-password
